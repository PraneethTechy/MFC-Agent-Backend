# Manufacturing Cost Agent Backend - Environment Configuration
# Copy this file to .env and configure values for your environment.

# Database Configuration (Neon Serverless PostgreSQL)
# Required: Provide your Neon pooled connection string with sslmode=require
DATABASE_URL=postgresql+psycopg://AGENT_RW_USER:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# CORS Allowed Origins
# Comma-separated list of origins allowed to connect (e.g., your Vercel production frontend)
# Use '*' only for open public access. Localhost origins (http://localhost:5173) are always permitted.
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Domo AI Services (Optional - for LLM-driven natural language narrative synthesis)
DOMO_SUBDOMAIN=gwcteq-partner
DOMO_TOKEN=YOUR_DOMO_DEVELOPER_TOKEN
DOMO_MODEL=YOUR_ENABLED_DOMO_MODEL_ID

# Runtime Operational Data Mode
# Options: "PRODUCTION" (strict real production/baseline records) or "DEMO"
DATA_MODE=PRODUCTION

# Server Port (automatically provided by cloud platforms like Render / Railway)
PORT=8000
HOST=0.0.0.0
